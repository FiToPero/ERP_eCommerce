APP_NAME=ERP_Commerce
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Esta URL mantiene el entorno de testing alineado con el dominio del admin usado en desarrollo.
APP_URL=http://cap-erp-admin-dev.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=erpecommerce
DB_USERNAME=erpecommerce
DB_PASSWORD=erpecommerce

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=strict
# Esta cookie de sesión queda asociada al dominio del admin también durante pruebas funcionales.
SESSION_DOMAIN=cap-erp-admin-dev.com

# Esta URL identifica el frontend Vue de desarrollo al que Laravel debe permitir acceso API.
FRONTEND_URL=http://cap-erp-ecommerce-dev.com

# Esta lista reconoce tanto el admin como la SPA de desarrollo como orígenes stateful válidos.
SANCTUM_STATEFUL_DOMAINS=cap-erp-admin-dev.com,cap-erp-ecommerce-dev.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=erpecommerce_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=0        
REDIS_SESSION_DB=1
REDIS_QUEUE_DB=2       
REDIS_QUEUE=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Este host alinea el HMR de testing con el dominio público del admin sin usar `localhost`.
VITE_HMR_HOST=cap-erp-admin-dev.com
# Este puerto mantiene el Vite server de Laravel escuchando dentro del contenedor `node`.
VITE_HMR_PORT=5173
# Este puerto indica al navegador que el HMR se expone vía Nginx en el puerto 80.
VITE_HMR_CLIENT_PORT=80
# Este protocolo conserva websocket plano para el ciclo de desarrollo y pruebas.
VITE_HMR_PROTOCOL=ws
# Este path separa el socket HMR del resto del enrutamiento de Laravel.
VITE_HMR_PATH=/vite-hmr
# Esta URL obliga a publicar assets dev con el dominio visible del admin.
VITE_DEV_SERVER_URL=http://cap-erp-admin-dev.com
